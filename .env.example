# ---------------------------------------------------------------------------
# AMDOX ERP — environment variables
#
# EVERY VARIABLE BELOW IS OPTIONAL. The app boots and runs with zero config,
# which is what makes it deployable to Vercel by simply importing the repo.
# ---------------------------------------------------------------------------

# HMAC key used to sign session cookies. If unset, a per-deployment key is
# derived automatically. Set this in production so sessions survive redeploys.
AUTH_SECRET=change-me-to-a-long-random-string

# Session lifetime in seconds (default: 28800 = 8 hours).
SESSION_TTL_SECONDS=28800

# Sliding-window rate limit for /api/v1/* (defaults: 240 requests / 60s per IP).
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60
